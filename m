index 0000000..4319b02
--- /dev/null
+++ b/drivers/thermal/rcar_thermal.c
@@ -0,0 +1,239 @@
+/*
+ *  R-Car THS/TSC thermal sensor driver
+ *
+ * Copyright (C) 2012 Renesas Solutions Corp.
+ * Kuninori Morimoto <kuninori.morimoto.gx@renesas.com>
+ *
