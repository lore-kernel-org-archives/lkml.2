>> +               ret =3D tpm_pm_suspend(&client->dev);
>>         }
>>         return ret;
>>  }                              /* tpm_st33_i2c_suspend() */
>> @@ -848,12 +848,12 @@ static int tpm_st33_i2c_pm_resume(struct i2c_clien=
t *client)
>>                                           (chip->vendor.status(chip) &&
>>                                           TPM_STS_VALID) =3D=3D TPM_STS_=
