+/*
+ * Check BCLK direction.  Returns >0 if the BCLK pin is an output, 0 if it's an
+ * input, or negative error.
+ */
+static inline int aic3204_check_bclk_is_output(
+		struct snd_soc_dapm_widget *source,
+		struct snd_soc_dapm_widget *sink)
+{
+	int reg = snd_soc_read(source->codec, AIC3204_AISR1);
