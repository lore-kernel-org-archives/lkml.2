 #include <linux/types.h>
 
-struct pinmux_info;
 struct resource;
 
 int sh_pfc_register(const char *name,
-		    struct resource *resource, u32 num_resources,
-		    struct pinmux_info *pdata);
+		    struct resource *resource, u32 num_resources);
 
