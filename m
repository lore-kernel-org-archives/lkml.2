 		if (ret < 0)
@@ -740,7 +703,7 @@ static void update_event(const char *name, const char *filter,
 		if (!strlen(ptr) || strcmp(ptr, "*") == 0) {
 			ret = update_glob(str, filter, filter_only, update);
 			free(str);
-			put_tracing_file(path);
