+	reg &= AIC3204_CLK1_PLLSRC;
+
+	if (reg == AIC3204_CLK1_PLLSRC_MCLK)
+		reg = (!strcmp(source->name, "MCLK"));
+	else if (reg == AIC3204_CLK1_PLLSRC_BCLK)
+		reg = (!strcmp(source->name, "BCLK"));
+	else if (reg == AIC3204_CLK1_PLLSRC_GPIO)
+		reg = (!strcmp(source->name, "GPIO"));
