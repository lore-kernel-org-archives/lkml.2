-		if ((sz > 0) && (sz <= smd_read_avail(ctxt->ch)))
-			queue_work(qmi_wq, &ctxt->read_work);
-		break;
-	}
-	case SMD_EVENT_OPEN:
-		printk(KERN_INFO "qmi: smd opened\n");
-		queue_work(qmi_wq, &ctxt->open_work);
-		break;
-	case SMD_EVENT_CLOSE:
